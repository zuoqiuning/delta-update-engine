/docs/design/*.draft.md
/docs/design/**/*.draft.md

# tauri generated
**/src-tauri/gen/schemas

# test fixtures
e2e/fixtures
crates/delta-update-testkit/fixtures

# secrets and logs
*.log
*.key
*.pem
.env
.env.*
